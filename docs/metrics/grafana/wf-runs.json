      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "minWidth": 100
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "per_review"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 1
              }
