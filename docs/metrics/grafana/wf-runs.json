    {
      "id": 3,
      "type": "table",
      "title": "Errors and retries per model",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "minWidth": 100
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.0",
          "rawSql": "SELECT harness, model, count() AS attempts,\n       countIf(attempt > 1) AS retries,\n       countIf(outcome IN ('failed', 'timed_out', 'unavailable')) AS failed,\n       countIf(error_class = 'rate_limit') AS rate_limit,\n       countIf(error_class = 'dropped_connection') AS dropped,\n       countIf(error_class = 'timeout') AS timeout,\n       countIf(error_class NOT IN ('', 'rate_limit', 'dropped_connection', 'timeout')) AS other\nFROM wf.attempts FINAL\nWHERE $__timeFilter(started) AND kind = 'agent'\n  AND $__conditionalAll(workflow IN (${workflow:singlequote}), $workflow)\nGROUP BY harness, model\nORDER BY failed DESC, attempts DESC"
        }
      ],
      "description": "Retries are attempts after the first. The last four columns count attempts by the class of their error."
    },
    {
      "id": 4,
      "type": "table",
      "title": "Tokens and cost per model",
      "gridPos": {
        "h": 7,
        "w": 24,
