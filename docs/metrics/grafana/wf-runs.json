      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.0",
          "rawSql": "SELECT harness, model, count() AS attempts, sum(tokens) AS total,\n       sum(input_tokens) AS input, sum(output_tokens) AS output, sum(reasoning_tokens) AS reasoning,\n       sum(cache_read_tokens) AS cache_read, sum(cache_write_tokens) AS cache_write, sum(cost_usd) AS cost\nFROM wf.attempts FINAL\nWHERE $__timeFilter(started) AND kind = 'agent'\n  AND $__conditionalAll(workflow IN (${workflow:singlequote}), $workflow)\nGROUP BY harness, model\nORDER BY cost DESC, total DESC"
        }
      ],
      "description": "Tokens and cost of the attempts of agent nodes."
    },
