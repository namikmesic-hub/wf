          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.0",
          "rawSql": "SELECT harness, model, count() AS calls, avg(duration_ms) AS mean, quantile(0.95)(duration_ms) AS p95,\n       countIf(ifNull(is_error, false)) AS errors, sum(duration_ms) AS total\nFROM wf.tool_calls FINAL\nWHERE $__timeFilter(started)\n  AND $__conditionalAll(workflow IN (${workflow:singlequote}), $workflow)\nGROUP BY harness, model\nORDER BY calls DESC"
        }
      ],
      "description": "The tool calls of agents, with their mean and p95 time, their errors, and their total time."
